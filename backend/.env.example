# OpenRouter: used for both the chat LLM and embeddings
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=mistralai/mistral-7b-instruct
# Optional attribution headers, e.g. http://your-elastic-ip and "AIMS RAG"
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=

# Embeddings (OpenRouter /embeddings). Changing either requires DROP TABLE chunks; then re-index.
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# Postgres + pgvector. docker compose sets POSTGRES_HOST=db for the containers.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Document Storage
DOCUMENTS_PATH=./data/documents

# Scraping Configuration
SCRAPE_DELAY_SECONDS=2.0
MAX_DEPTH=5
RESPECT_ROBOTS_TXT=true

# Chunking Configuration
CHUNK_SIZE=400
CHUNK_OVERLAP=75

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/pipeline.log
